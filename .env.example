# Copy the BACKEND section to backend/.env
# --- local development ---
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/agri_marketplace
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://127.0.0.1:8000
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/INR
# disk = save uploads to ./uploads (dev) | gridfs = save to MongoDB (production)
UPLOAD_STORAGE=disk

# --- production (set these in the Render dashboard, never commit them) ---
# PORT                = provided by the host (Render), do not set it yourself
# MONGODB_URI         = your MongoDB Atlas SRV string
# CLIENT_ORIGIN       = your Vercel URL, e.g. https://your-app.vercel.app
#                       (comma-separate several URLs if you have more than one)
# AI_SERVICE_URL      = your deployed AI service URL
# UPLOAD_STORAGE      = gridfs
# JWT_SECRET          = long random string (Render's blueprint generates one)

# Only for `npm --prefix backend run seed:admin` (admin is never created automatically)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# FRONTEND (frontend/.env, optional): VITE_API_URL= (empty in dev; Vite proxies /api to :5000)
